<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% if page.layout == "home" %><title><%= site.config["title"] %> — <%= site.config["tagline"] %></title><% else %><title><%= page.title %> · <%= site.config["title"] %></title><% end %>
<meta name="description" content="<%= page.description.empty? ? site.config["description"] : page.description %>">
<meta property="og:title" content="<%= page.title %>">
<meta property="og:description" content="<%= page.description.empty? ? site.config["description"] : page.description %>">
<meta property="og:url" content="<%= site.config["base_url"] + page.url %>">
<meta property="og:type" content="website">
<link rel="canonical" href="<%= site.config["base_url"] + page.url %>">
<link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/style.css">
<script>try{var t=localStorage.getItem("theme");if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
<script src="/assets/site.js" defer></script>
</head>
<body class="layout-<%= page.layout %>">
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Fola home"><img src="/assets/logo.svg" alt="" width="28" height="28"><span>fola</span></a>
    <button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Sections">
      <% nav.each do |item| %><a href="<%= item[1] %>"<% if item[2] %> aria-current="true"<% end %>><%= item[0] %></a><% end %>
      <a href="/play/">Playground</a>
    </nav>
    <div class="header-tools">
      <button class="search-open" type="button" aria-label="Search the docs">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span>Search</span><kbd>/</kbd>
      </button>
      <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
        <svg class="i-sun" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="3.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M9 1.5v2M9 14.5v2M1.5 9h2M14.5 9h2M3.7 3.7l1.4 1.4M12.9 12.9l1.4 1.4M3.7 14.3l1.4-1.4M12.9 5.1l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <svg class="i-moon" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M14.5 11.2A6 6 0 0 1 6.8 3.5a6 6 0 1 0 7.7 7.7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      </button>
      <a class="gh" href="<%= site.config["repo"] %>" aria-label="Fola on GitHub">
        <svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
    </div>
  </div>
</header>

<main id="main">
<%== content %>
</main>

<footer class="site-footer">
  <div class="footer-inner">
    <p>Fola is open source under the MIT license. This site is generated by <a href="<%= site.config["site_repo"] %>/blob/main/build.fola">build.fola</a>, written in Fola.</p>
    <p><a href="<%= site.config["repo"] %>">GitHub</a> · <a href="/contribute/">Contribute</a> · <a href="<%= site.config["repo"] %>/blob/main/CHANGELOG.md">Changelog</a></p>
  </div>
</footer>

<div class="search" hidden>
  <div class="search-backdrop" data-close></div>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search">
    <input class="search-input" type="search" placeholder="Search the docs" autocomplete="off" spellcheck="false" aria-label="Search the docs">
    <ul class="search-results" role="listbox"></ul>
    <p class="search-hint"><kbd>↑</kbd><kbd>↓</kbd> to move · <kbd>Enter</kbd> to open · <kbd>Esc</kbd> to close</p>
  </div>
</div>
</body>
</html>
